# Ortam Değişkenleri Örnek Dosyası
# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek API key'lerinizi ekleyin
# cp env.example .env

# NewsAPI Key (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# Google Gemini API Key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search API Key (https://developers.google.com/custom-search/v1/overview)
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_ID=your_google_cse_engine_id_here

# Firebase Firestore (Opsiyonel - Watchlist için)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# MLflow Tracking URI (Opsiyonel - Model tracking için)
# MLFLOW_TRACKING_URI=http://localhost:5000

